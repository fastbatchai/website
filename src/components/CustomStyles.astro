---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* fastbatch brand: slate from the logo wordmark, warm accent for CTAs */
    --aw-color-primary: rgb(45 63 77);
    --aw-color-secondary: rgb(30 44 55);
    --aw-color-accent: rgb(217 119 6);

    --aw-color-text-heading: rgb(24 32 38);
    --aw-color-text-default: rgb(35 45 52);
    --aw-color-text-muted: rgb(35 45 52 / 66%);
    --aw-color-bg-page: rgb(250 250 249);

    --aw-color-bg-page-dark: rgb(17 24 30);

    ::selection {
      background-color: rgb(217 119 6 / 30%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(120 145 165);
    --aw-color-secondary: rgb(148 168 185);
    --aw-color-accent: rgb(245 158 11);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(225 231 237);
    --aw-color-text-muted: rgb(225 231 237 / 66%);
    --aw-color-bg-page: rgb(17 24 30);

    ::selection {
      background-color: rgb(245 158 11 / 40%);
      color: snow;
    }
  }
</style>
